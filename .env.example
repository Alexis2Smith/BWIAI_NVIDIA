# Copy this file to .env for local testing with `netlify dev`. Never commit .env.
NVIDIA_API_KEY=nvapi-your-key-here
# Optional overrides:
# NVIDIA_SAFETY_MODEL=nvidia/nemotron-3.5-content-safety
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# TOPIC_CONTROL=off   (comparison testing only)
#
# Safety endpoint (content safety and topic control rails only):
# NVIDIA_SAFETY_BASE_URL=https://integrate.api.nvidia.com/v1     (default: same as NVIDIA_BASE_URL)
# NVIDIA_SAFETY_FALLBACK_URL=https://your-safety-nim.example/v1   (tried only if the first safety endpoint fails)
# NVIDIA_SAFETY_API_KEY=token-for-your-self-hosted-endpoint       (NVIDIA_API_KEY is never sent to non-NVIDIA addresses)
#
# Crisis response is always on. Optional staff alert (off until a district connects its own channel):
# ALERT_WEBHOOK_URL=https://your-district.webhook.office.com/...   (https only)
# ALERT_WEBHOOK_FORMAT=teams   (teams, slack, or json)
# ALERT_SITE_LABEL=Lincoln Middle School
# THREAT_ALERT_WEBHOOK_URL=https://your-district.webhook.office.com/...   (threat-assessment team; https only)
# THREAT_ALERT_WEBHOOK_FORMAT=teams
